{
  "name": "@scadforge/scad-core",
  "version": "0.0.0",
  "private": true,
  "description": "OpenSCAD project model: types, parameter parsing, filesystem project store, mesh validation, and the OpenSCAD CLI runner",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "default": "./dist/geometry/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@scadforge/protocol": "workspace:*",
    "diff": "^8.0.4",
    "manifold-3d": "^3.1.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
